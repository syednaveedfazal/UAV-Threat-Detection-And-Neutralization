<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>poc1_landing_world</name>
  <version>0.0.0</version>
  <description>PoC 1: landing-pad world and offboard mission control for PX4 SITL on Gazebo Harmonic.</description>
  <maintainer email="syed@todo.todo">syed</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>px4_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Modern Gazebo (Harmonic). The Gazebo Classic 'gazebo_ros' dependency
       was removed: this package launches gz sim, not gzserver. -->
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>