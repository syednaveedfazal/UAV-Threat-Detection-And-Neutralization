{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene_manifest.schema.json",
  "title": "Engine-neutral scene manifest (build_real_site.py --export-scene)",
  "description": "Everything a renderer (Unity now, Isaac Sim later) needs to rebuild the real site. World frame: ENU metres, origin at the launch pad.",
  "type": "object",
  "required": ["manifest_version", "site", "frame", "regions", "assets", "buildings",
               "trees", "perimeter", "actors", "launch_pad", "camera", "sun", "stats"],
  "$defs": {
    "vec2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "box": {"type": "object", "required": ["min", "max"],
            "properties": {"min": {"$ref": "#/$defs/vec2"}, "max": {"$ref": "#/$defs/vec2"}}}
  },
  "properties": {
    "manifest_version": {"const": 1},
    "site": {"type": "string", "minLength": 1},
    "frame": {
      "type": "object",
      "required": ["convention", "gltf_axes", "origin_utm", "origin_wgs84", "bbox_world"],
      "properties": {
        "origin_utm": {"$ref": "#/$defs/vec3"},
        "origin_wgs84": {
          "type": "object", "required": ["lat", "lon", "elevation_m"],
          "properties": {"lat": {"type": "number", "minimum": -90, "maximum": 90},
                         "lon": {"type": "number", "minimum": -180, "maximum": 180},
                         "elevation_m": {"type": "number"}}}
      }
    },
    "regions": {
      "type": "object", "required": ["full", "compound"],
      "properties": {"full": {"$ref": "#/$defs/box"}, "compound": {"$ref": "#/$defs/box"}}
    },
    "assets": {
      "type": "object", "required": ["terrain", "buildings", "ndvi"],
      "properties": {
        "terrain": {"type": "object", "required": ["file", "tiles"],
          "properties": {"file": {"const": "terrain.glb"},
            "tiles": {"type": "array", "minItems": 1, "items": {
              "type": "object", "required": ["name", "min", "size_m", "texture_px"],
              "properties": {"name": {"type": "string", "pattern": "^terrain_[0-9]+_[0-9]+$"},
                             "min": {"$ref": "#/$defs/vec2"},
                             "size_m": {"type": "number", "exclusiveMinimum": 0},
                             "texture_px": {"type": "integer", "minimum": 1}}}}}},
        "buildings": {"type": "object", "required": ["file", "nodes"],
          "properties": {"file": {"const": "buildings.glb"},
                         "nodes": {"type": "array", "items": {"type": "string"}, "minItems": 1}}},
        "ndvi": {"type": "object", "required": ["file", "m_per_px", "vegetation_threshold_ndvi"]}
      }
    },
    "buildings": {"type": "array", "items": {
      "type": "object", "required": ["id", "category", "centroid", "source"],
      "properties": {
        "category": {"enum": ["residential", "commercial", "public", "structure", "other", "unknown"]},
        "height_m": {"type": ["number", "null"], "minimum": 0},
        "centroid": {"$ref": "#/$defs/vec2"}}}},
    "trees": {"type": "array", "items": {
      "type": "array", "items": {"type": "number"}, "minItems": 5, "maxItems": 5}},
    "perimeter": {"type": "array", "items": {
      "type": "object", "required": ["type", "centre", "size", "yaw"],
      "properties": {
        "type": {"enum": ["fence", "post", "gate", "booth", "booth_roof", "window", "pole", "lamp"]},
        "centre": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/vec3"},
        "yaw": {"type": "number"}}}},
    "actors": {"type": "array", "items": {
      "type": "object", "required": ["name", "speed", "loop", "waypoints"],
      "properties": {
        "speed": {"type": "number", "exclusiveMinimum": 0},
        "waypoints": {"type": "array", "minItems": 2, "items": {
          "type": "object", "required": ["t", "x", "y", "z_ground", "yaw"]}}}}},
    "launch_pad": {"$ref": "#/$defs/vec3"},
    "camera": {"type": "object"},
    "sun": {"type": "object"},
    "stats": {"type": "object", "required": ["buildings", "trees", "terrain_tiles"]}
  }
}
